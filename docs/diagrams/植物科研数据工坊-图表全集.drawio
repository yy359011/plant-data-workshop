        <mxCell id="79" value="实际边界：平台生产训练数据，不执行大模型训练。知识库当前为关键词检索；抽检通过率只描述样本。角色固定为管理员、所内、所外。" style="whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontColor=#203A56;fontSize=18;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#55738E;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="1685" width="2650" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
