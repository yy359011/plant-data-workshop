        <mxCell id="431" value="角色与发布条件是实际访问控制；“授权标签”仍需基于资料权利依据填写，系统不会自动判断版权或模型 API 条款。" style="whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontColor=#203A56;fontSize=18;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#55738E;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="1615" width="1950" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
