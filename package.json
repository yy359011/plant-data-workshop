  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@tabler/icons-vue": "^3.34.0",
    "element-plus": "^2.9.0",
    "pdfjs-dist": "3.11.174",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "sass": "^1.86.0",
    "typescript": "~5.8.0",
    "vite": "6.4.2"
  }
}
